        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(up{job=\"astralog-brokers\",instance=~\"host[.]docker[.]internal:920[1-3]\"})",
          "legendFormat": "Scrape targets reachable",
          "refId": "A",
          "range": true,
          "editorMode": "code"
